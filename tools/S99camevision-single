#!/bin/sh
# Boot: start CameVision Single live page. Never change the USB gadget.
# $1 is "start" from rcS. Detach with setsid so this survives sysinit.
[ "$1" = "start" ] || [ -z "$1" ] || exit 0
chmod 755 /userdata/camevision-single.sh 2>/dev/null
if [ ! -x /userdata/camevision-single.sh ]; then
	exit 0
fi
setsid /bin/sh -c 'sleep 8; exec /userdata/camevision-single.sh' \
	</dev/null >/userdata/single-live-boot.log 2>&1 &
exit 0
